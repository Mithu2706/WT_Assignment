<?xml version="1.0" encoding="UTF-8"?>
<!--
    WEB-INF/web.xml – Deployment descriptor of the Servlet portal (Question 3).
    Declares every servlet and its URL, the session settings, the welcome
    page and the error pages. Files inside WEB-INF (including the JSP views
    in WEB-INF/views) can NOT be requested directly by a browser – they are
    only reachable through the servlets, which check the login session first.
    Servlet 3.1 = Apache Tomcat 8.x (javax.servlet.*).
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="true">

    <display-name>Student Portal - Servlet and JSP</display-name>

    <!-- Default locale for JSTL <fmt:formatDate>. Without it, a request with no
         Accept-Language header would print dates in raw toString() form. -->
    <context-param>
        <param-name>javax.servlet.jsp.jstl.fmt.locale</param-name>
        <param-value>en_IN</param-value>
    </context-param>

    <!-- Cleans up the JDBC driver when the app is stopped/redeployed -->
    <listener>
        <listener-class>com.studentportal.util.AppLifecycleListener</listener-class>
    </listener>

    <!-- ================= Servlets ================= -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.studentportal.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.studentportal.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>StudentListServlet</servlet-name>
        <servlet-class>com.studentportal.controller.StudentListServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>StudentProfileServlet</servlet-name>
        <servlet-class>com.studentportal.controller.StudentProfileServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>FileDownloadServlet</servlet-name>
        <servlet-class>com.studentportal.controller.FileDownloadServlet</servlet-class>
    </servlet>

    <!-- ================= URL mappings ================= -->
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StudentListServlet</servlet-name>
        <url-pattern>/students</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StudentProfileServlet</servlet-name>
        <url-pattern>/student</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FileDownloadServlet</servlet-name>
        <url-pattern>/file</url-pattern>
    </servlet-mapping>

    <!-- ================= Session handling ================= -->
    <session-config>
        <session-timeout>30</session-timeout>          <!-- minutes of inactivity -->
        <cookie-config>
            <http-only>true</http-only>                <!-- JavaScript cannot read JSESSIONID -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>          <!-- never put ;jsessionid= in URLs -->
    </session-config>

    <!-- All JSP pages AND the included .jspf fragments are UTF-8 encoded -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ================= Friendly error pages (no stack traces) ================= -->
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>405</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
</web-app>
