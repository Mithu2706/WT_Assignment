<%--
    Shared page header (statically included).  Expects pageTitle to be set.
    All dynamic text is printed with <c:out>, which HTML-escapes it (XSS-safe).
--%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> · Student Profile Portal</title>
    <link rel="icon" href="${ctx}/assets/img/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="${ctx}/assets/css/portal.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="${ctx}/students">
            <img src="${ctx}/assets/img/favicon.svg" alt="" width="34" height="34">
            <span>Student Profile Portal<small>Servlet · JSP · JDBC</small></span>
        </a>
        <c:if test="${not empty currentUser}">
            <nav class="main-nav" aria-label="Main">
                <c:choose>
                    <c:when test="${currentUser.student}">
                        <a href="${ctx}/student?id=${currentUser.studentId}">My profile</a>
                    </c:when>
                    <c:otherwise>
                        <a href="${ctx}/students">All students</a>
                    </c:otherwise>
                </c:choose>
            </nav>
            <div class="user-box">
                <span class="avatar avatar-sm" aria-hidden="true"><c:out value="${currentUser.initials}"/></span>
                <span class="user-name"><c:out value="${currentUser.displayName}"/>
                    <small><c:out value="${currentUser.role}"/></small></span>
                <%-- Logout is a POST with a CSRF token; the session is invalidated on the server. --%>
                <form method="post" action="${ctx}/logout">
                    <input type="hidden" name="csrf_token" value="<c:out value='${sessionScope.csrfToken}'/>">
                    <button type="submit" class="btn btn-light btn-sm">Sign out</button>
                </form>
            </div>
        </c:if>
    </div>
</header>
<main id="main" class="page" tabindex="-1">
