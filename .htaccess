# ---------------------------------------------------------------------------
# Apache rules when the project folder is served by XAMPP (e.g. /wt-portal/).
# Only frontend/ and php-admin/public/ are meant to be reachable; every other
# folder carries its own "Require all denied" .htaccess.
# ---------------------------------------------------------------------------
Options -Indexes
DirectoryIndex index.html index.php

# Never serve dotfiles (.env, .git ...) or source/config/data file types.
<FilesMatch "(^\.|\.(env|md|sql|py|log|example|ini|properties|xml|json|bat|cmd|sh|lock|txt)$)">
    Require all denied
</FilesMatch>

# Block any path segment that starts with a dot (e.g. /.git/config, /.vscode/).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F]
</IfModule>
<IfModule !mod_rewrite.c>
    RedirectMatch 403 /\.
</IfModule>
