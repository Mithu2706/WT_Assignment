# ---------------------------------------------------------------
# Student Management Portal - shared configuration template
# Copy this file to ".env" (same folder) and fill in real values.
# BOTH the PHP admin module and the Java Servlet module read .env.
# .env is listed in .gitignore - never commit real credentials.
# Use forward slashes in paths (C:/path/to/dir), also on Windows.
# ---------------------------------------------------------------

# MySQL / MariaDB connection (use a dedicated low-privilege user, not root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wt_student_portal
DB_USER=smp_app
DB_PASS=change-me-to-a-long-random-password

# Private storage directory for uploaded files.
# A relative path is resolved against the folder that contains this .env file.
STORAGE_DIR=storage/uploads

# Idle session timeout (minutes) for both applications
SESSION_TIMEOUT_MINUTES=30

# "development" shows extra diagnostics in server logs only, never to users
APP_ENV=development
